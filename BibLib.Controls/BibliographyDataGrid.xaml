<UserControl x:Class="BibLib.Controls.BibliographyDataGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:BibLib.Controls"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance local:BibliographyDataGrid}">
    <Grid>
        <DataGrid
            x:Name="DataGrid"
            LoadingRow="DataGrid_OnLoadingRow"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            ItemsSource="{Binding Bibliographies}" />
    </Grid>
</UserControl>
